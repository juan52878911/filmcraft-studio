{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/juan52878911/filmcraft-studio/plugins/filmcraft-studio/schemas/ds.schema.json",
 "title": "Design system de video (ds.json) de filmcraft-studio",
 "description": "Lo que leen los scripts (ds_*.py, plan_compile.py, apply_plan.py, fcstyle.py, verify.py, promo_*.py, motor_blender.py). Las referencias cruzadas (rol→pista, rol→sfx en mapa, animación definida, tamaño de assets, contraste, fuente instalada) las comprueba ds_validate.py. Documentación: skills/design-system-video/references/esquema.md.",
 "type": "object",
 "required": ["id", "gramatica", "lienzo", "paleta", "fuentes", "marca", "pistas", "roles_texto", "animaciones",
              "continuidad", "transiciones", "fondos", "mattes", "sfx", "musica", "grade", "audio", "estructura"],
 "additionalProperties": false,
 "$defs": {
  "hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
  "colorRef": {"anyOf": [{"$ref": "#/$defs/hex"}, {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, {"type": "null"}],
               "description": "Un hex o el nombre de un color de paleta (fondo, rejilla, oscuro, claro, acento1..3)"},
  "fuente": {"type": "object", "required": ["familia"], "additionalProperties": false,
             "properties": {"familia": {"type": "string"}, "estilo": {"type": "string"}, "archivo": {"type": "string"}}},
  "fotogramas": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2}},
  "rol": {"type": "object", "required": ["fuente", "tam"], "additionalProperties": false,
   "properties": {
    "fuente": {"type": "string"}, "tam": {"type": "number", "exclusiveMinimum": 0},
    "color": {"$ref": "#/$defs/colorRef"},
    "fondo": {"anyOf": [{"$ref": "#/$defs/colorRef"}, {"type": "array", "items": {"$ref": "#/$defs/colorRef"}}]},
    "colores": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/colorRef"}, "minItems": 2, "maxItems": 2}},
    "margen": {}, "pista": {"type": "string"}, "pistas": {"type": "array", "items": {"type": "string"}},
    "pos": {"anyOf": [{"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, {"type": "null"}]},
    "zona": {"type": "string"}, "align": {"type": "string"},
    "anim": {"enum": ["popIn", "wordReveal", "eco", "calorEntra", "golpe", "desliza", "caida", "pop", "escribe", "ninguna"]},
    "inclina": {"anyOf": [{"type": "number"}, {"type": "array", "items": {"type": "number"}}]},
    "sombra": {"type": "object", "additionalProperties": false,
     "properties": {"color": {"$ref": "#/$defs/colorRef"}, "dist": {"type": "number"}, "angulo": {"type": "number"},
                    "blur": {"type": "number"}, "tam": {"type": "number"}}},
    "contorno": {"type": "object", "additionalProperties": false,
     "properties": {"color": {"$ref": "#/$defs/colorRef"}, "ancho": {"type": "number"}}},
    "prefijo": {"type": "object", "additionalProperties": false,
     "properties": {"texto": {"type": "string"}, "color": {"$ref": "#/$defs/colorRef"}}},
    "resalta": {"$ref": "#/$defs/colorRef"}, "resalta_max": {"type": "integer", "minimum": 0},
    "max_palabras": {"type": "integer", "minimum": 1}, "pista_letras": {"type": "number"},
    "sfx": {"type": ["string", "null"]},
    "max_chars": {"type": "integer"}, "paso_y": {"type": "number"}, "paso_x": {"type": "number"}, "frames": {},
    "x": {"type": "number"}, "y": {"type": "number"}, "interlinea": {"type": "number"}}}
 },
 "properties": {
  "$schema": {"type": "string"},
  "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
  "nombre": {"type": "string"}, "version": {"type": "integer"}, "descripcion": {"type": "string"},
  "gramatica": {"type": "string", "pattern": "^[a-z0-9-]+@[0-9]+$"},
  "match": {"type": "object", "additionalProperties": false,
   "properties": {"rutas": {"type": "array", "items": {"type": "string"}}, "palabras": {"type": "array", "items": {"type": "string"}},
                  "flyer": {"type": ["string", "null"]}, "paleta_ref": {"type": "array", "items": {"$ref": "#/$defs/hex"}}}},
  "lienzo": {"type": "object", "required": ["ancho", "alto", "fps"], "additionalProperties": false,
   "properties": {"ancho": {"type": "integer", "minimum": 16}, "alto": {"type": "integer", "minimum": 16},
                  "fps": {"type": "number", "exclusiveMinimum": 0}, "plataforma": {"type": "string"},
                  "variantes": {"type": "object", "additionalProperties": {"type": "object", "required": ["ancho", "alto"],
                    "properties": {"ancho": {"type": "integer"}, "alto": {"type": "integer"}, "nota": {"type": "string"}}}}}},
  "paleta": {"type": "object", "required": ["fondo", "oscuro", "claro", "acento1"], "additionalProperties": {"$ref": "#/$defs/hex"},
   "description": "claro = el color luminoso (texto sobre cajas oscuras); oscuro = el de las cajas/texto oscuro, aunque el fondo sea claro"},
  "fuentes": {"type": "object", "required": ["titular", "ui", "meta"], "additionalProperties": {"$ref": "#/$defs/fuente"}},
  "marca": {"type": "object", "required": ["barra", "titulo", "cta"],
   "properties": {"cierre_palabras": {"type": "array", "items": {"type": "string"}}},
   "additionalProperties": {"type": ["string", "array"]}},
  "pistas": {"type": "object", "required": ["video", "audio"], "additionalProperties": false,
   "properties": {"video": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "audio": {"type": "array", "items": {"type": "string"}},
                  "sfx": {"type": "array", "items": {"type": "string"}}}},
  "roles_texto": {"type": "object", "required": ["marca", "subtitulo", "etiqueta", "eco", "pill", "tag", "titulo", "cierre", "meta", "pie"],
   "additionalProperties": {"$ref": "#/$defs/rol"}},
  "animaciones": {"type": "object", "required": ["base_fps", "popIn", "wordReveal", "eco"],
   "properties": {"base_fps": {"type": "number"},
                  "wordReveal": {"type": "object", "required": ["paso_f", "fade_f", "dy"]}}},
  "continuidad": {"type": "object", "required": ["entrada", "zoom_crash"]},
  "transiciones": {"type": "object", "required": ["preferencia", "corte"],
   "properties": {"preferencia": {"type": "array", "items": {"type": "string"}}}},
  "fondos": {"type": "object", "required": ["titulo", "plano", "cap", "cierre"], "additionalProperties": {"type": "string"}},
  "mattes": {"type": "object", "required": ["blanco"], "additionalProperties": {"type": "string"}},
  "sfx": {"type": "object", "required": ["dir", "mapa"], "additionalProperties": false,
   "properties": {"dir": {"type": "string"}, "nivel_db": {"type": "number"}, "mapa": {"type": "object", "additionalProperties": {"type": "string"}}}},
  "musica": {"type": "object", "required": ["bajo_voz_db", "sin_voz_db"],
   "properties": {"bpm": {"type": "number"}, "bajo_voz_db": {"type": "number"}, "sin_voz_db": {"type": "number"},
                  "rampa_s": {"type": "number"}, "salida_s": {"type": "number"},
                  "ninguna": {"type": "boolean", "description": "Sin base musical (pegatina@1: solo voz y golpes)"}}},
  "grade": {"type": "object"},
  "audio": {"type": "object", "required": ["lufs", "pico_dbtp"],
   "properties": {"lufs": {"type": "number"}, "pico_dbtp": {"type": "number"}}},
  "estructura": {"type": "object", "required": ["duracion_s"],
   "properties": {"duracion_s": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}},
  "ritmo": {"type": "object"}, "zonas": {"type": "object"}, "vocabulario": {"type": "string"},
  "promo": {"type": "object", "required": ["bpm"],
   "description": "Solo en DS de promo por código. bpm (promo_preview.py) y mapas (promo_gradmap.py, gramáticas termo y tres-fases) se leen; el resto es guía en prosa para quien escribe la escena.",
   "properties": {"bpm": {"type": "number", "exclusiveMinimum": 0}, "firma": {"type": "string"}, "motor": {"type": "string"},
                  "mapas": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "number"}, {"$ref": "#/$defs/hex"}]}}}}},
  "termo": {"type": "object", "description": "Guía en prosa de la gramática termo (ningún script la lee)"},
  "tarjetas": {"type": "object", "description": "pegatina@1: valores por defecto de cada tipo de tarjeta compuesta (ponente, fecha, qr, logo, flecha)",
   "additionalProperties": {"type": "object", "additionalProperties": false,
    "properties": {"anim": {"enum": ["golpe", "desliza", "caida", "pop", "ninguna"]}, "inclina": {"type": "number"},
                   "pos": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
                   "pista": {"type": "string"}, "sfx": {"type": ["string", "null"]}}}},
  "estado": {"type": "object", "description": "La escribe ds_studio.py: borrador, creado/aprobado, iteracion(es), spec, cambios",
   "properties": {"borrador": {"type": "boolean"}, "iteracion": {"type": "integer"}, "iteraciones": {"type": "integer"}}},
  "derivado_de": {"type": "object", "description": "La escribe ds_studio.py/ds_from_image.py: base (id del DS de origen), flyer, descripcion",
   "properties": {"base": {"type": "string"}}}
 }
}
