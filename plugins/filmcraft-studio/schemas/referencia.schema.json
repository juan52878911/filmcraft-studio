{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/juan52878911/filmcraft-studio/plugins/filmcraft-studio/schemas/referencia.schema.json",
 "title": "Ficha de una referencia de arte: métricas medidas, filosofía y traducción a video",
 "description": "La escribe scripts/ref_metricas.py (capa 1 y lo medible de la 3); el modelo rellena `filosofia` y `video.plan`. Referencia: skills/preproduccion/references/referencias.md.",
 "type": "object",
 "required": ["version", "archivo", "imagen", "metricas", "reproducir", "filosofia", "video"],
 "$defs": {
  "u": {"type": "number", "minimum": 0, "maximum": 1},
  "s": {"type": "number", "minimum": -1, "maximum": 1},
  "txt": {"type": ["string", "null"]},
  "lista": {"type": "array", "items": {"type": "string"}},
  "punto": {"type": "object", "required": ["x", "y"], "properties": {"x": {"$ref": "#/$defs/u"}, "y": {"$ref": "#/$defs/u"}}},
  "cerca": {"type": "object", "required": ["distancia", "punto"],
            "properties": {"distancia": {"$ref": "#/$defs/u"}, "punto": {"enum": ["sup-izq", "sup-der", "inf-izq", "inf-der"]}}},
  "ritmo": {"type": "object", "required": ["periodo", "fuerza"],
            "properties": {"periodo": {"type": ["number", "null"]}, "fuerza": {"$ref": "#/$defs/u"}}}
 },
 "properties": {
  "version": {"enum": [1, 2]},
  "archivo": {"type": "string"},
  "tiempo_ms": {"type": "number"},
  "imagen": {"type": "object", "required": ["ancho", "alto", "aspecto"],
             "properties": {"ancho": {"type": "integer", "minimum": 1}, "alto": {"type": "integer", "minimum": 1},
                            "aspecto": {"type": "number", "exclusiveMinimum": 0},
                            "orientacion": {"enum": ["horizontal", "vertical", "cuadrada"]},
                            "bandas": {"type": "object", "description": "Bandas negras (letterbox/pillarbox), en fracción de cada lado.",
                                       "properties": {"arriba": {"$ref": "#/$defs/u"}, "abajo": {"$ref": "#/$defs/u"},
                                                      "izq": {"$ref": "#/$defs/u"}, "der": {"$ref": "#/$defs/u"}}}}},
  "firma": {"type": "object", "required": ["lado", "L"],
            "description": "Miniatura de luminancia del contenido (sin bandas), lado×lado bytes en base64. La usa referencias.py --comparar para reconocer la misma imagen espejada, girada o recortada sin tener el archivo.",
            "properties": {"lado": {"type": "integer", "minimum": 8}, "L": {"type": "string"}}},
  "metricas": {
   "type": "object",
   "required": ["color", "valores", "composicion", "textura", "bordes", "profundidad", "texto"],
   "properties": {
    "color": {
     "type": "object",
     "required": ["paleta", "armonia", "temperatura", "croma_media", "croma_p90", "colorido", "colores_efectivos"],
     "properties": {
      "paleta": {"type": "array", "minItems": 1, "items": {
       "type": "object", "required": ["hex", "proporcion", "oklch", "papel"],
       "properties": {"hex": {"type": "string", "pattern": "^#[0-9A-F]{6}$"}, "proporcion": {"$ref": "#/$defs/u"},
                      "oklch": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
                      "papel": {"enum": ["dominante", "secundario", "acento", "apoyo"]}}}},
      "armonia": {"type": "object", "required": ["tipo", "tonos", "dispersion", "cromatico"],
                  "properties": {"tipo": {"enum": ["acromatica", "monocromatica", "analoga", "diada", "complementaria",
                                                   "complementaria_dividida", "triada", "tetrada", "policromatica"]},
                                 "tonos": {"type": "array", "items": {"type": "object", "required": ["tono", "peso"]}},
                                 "dispersion": {"$ref": "#/$defs/u"}, "cromatico": {"$ref": "#/$defs/u"}}},
      "temperatura": {"$ref": "#/$defs/s"}, "calido": {"$ref": "#/$defs/u"}, "frio": {"$ref": "#/$defs/u"},
      "croma_media": {"type": "number", "minimum": 0}, "croma_p90": {"type": "number", "minimum": 0},
      "colorido": {"type": "number", "minimum": 0}, "colores_efectivos": {"type": "number", "minimum": 1}}},
    "valores": {
     "type": "object",
     "required": ["histograma", "media", "mediana", "p05", "p95", "rango", "clave", "contraste_global",
                  "contraste_local", "notan2", "notan3"],
     "properties": {
      "histograma": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/u"}},
      "media": {"$ref": "#/$defs/u"}, "mediana": {"$ref": "#/$defs/u"}, "p05": {"$ref": "#/$defs/u"},
      "p95": {"$ref": "#/$defs/u"}, "rango": {"$ref": "#/$defs/u"}, "clave": {"enum": ["alta", "media", "baja"]},
      "contraste_global": {"$ref": "#/$defs/u"}, "contraste_local": {"$ref": "#/$defs/u"},
      "notan2": {"type": "object", "required": ["umbral", "oscuro", "claro"]},
      "notan3": {"type": "object", "required": ["umbrales", "proporciones", "rejilla"],
                 "properties": {"umbrales": {"type": "array", "minItems": 2, "maxItems": 2},
                                "proporciones": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/u"}},
                                "rejilla": {"type": "array", "items": {"type": "string", "pattern": "^[012]+$"}}}}}},
    "composicion": {
     "type": "object",
     "required": ["puntos_fuertes", "centro_masa", "tercios", "aurea", "centro", "diagonales", "simetria",
                  "peso_cuadrantes", "balance_x", "balance_y", "espacio_negativo", "lineas", "orientacion_bordes",
                  "margen", "ritmo", "reticula"],
     "properties": {
      "puntos_fuertes": {"type": "array", "maxItems": 5, "items": {
       "allOf": [{"$ref": "#/$defs/punto"}], "required": ["peso"], "properties": {"peso": {"$ref": "#/$defs/u"}}}},
      "centro_masa": {"$ref": "#/$defs/punto"},
      "tercios": {"$ref": "#/$defs/cerca"}, "aurea": {"$ref": "#/$defs/cerca"},
      "centro": {"type": "object", "required": ["distancia"]},
      "diagonales": {"type": "object", "required": ["descendente", "ascendente"]},
      "simetria": {"type": "object", "required": ["horizontal", "vertical"],
                   "properties": {"horizontal": {"$ref": "#/$defs/u"}, "vertical": {"$ref": "#/$defs/u"}}},
      "peso_cuadrantes": {"type": "object", "required": ["sup_izq", "sup_der", "inf_izq", "inf_der"]},
      "balance_x": {"$ref": "#/$defs/s"}, "balance_y": {"$ref": "#/$defs/s"},
      "espacio_negativo": {"$ref": "#/$defs/u"},
      "lineas": {"type": "object", "required": ["horizontal", "vertical", "diagonal", "n", "principales", "horizonte"],
                 "properties": {"horizontal": {"$ref": "#/$defs/u"}, "vertical": {"$ref": "#/$defs/u"},
                                "diagonal": {"$ref": "#/$defs/u"}, "n": {"type": "integer"},
                                "principales": {"type": "array"},
                                "horizonte": {"type": ["object", "null"], "required": ["y", "confianza"],
                                              "description": "Recta casi horizontal (±10°) que separa dos regiones a todo lo ancho. null en piezas con texto (va a horizonte_descartado).",
                                              "properties": {"y": {"$ref": "#/$defs/u"}, "confianza": {"$ref": "#/$defs/u"},
                                                             "angulo": {"type": "number", "minimum": -10, "maximum": 10},
                                                             "inclinado": {"type": "boolean"}}},
                                "horizonte_descartado": {"type": "object"}}},
      "orientacion_bordes": {"type": "object", "required": ["histograma", "dominante", "anisotropia"],
                             "properties": {"histograma": {"type": "array", "minItems": 8, "maxItems": 8},
                                            "anisotropia": {"$ref": "#/$defs/u"}}},
      "margen": {"type": "object", "required": ["izq", "arriba", "der", "abajo", "a_sangre"]},
      "ritmo": {"type": "object", "required": ["x", "y"],
                "properties": {"x": {"$ref": "#/$defs/ritmo"}, "y": {"$ref": "#/$defs/ritmo"}}},
      "reticula": {"type": "object", "required": ["columnas", "filas", "confianza"]}}},
    "textura": {"type": "object", "required": ["entropia", "densidad_bordes", "alta_frecuencia", "grano"],
                "properties": {"entropia": {"$ref": "#/$defs/u"}, "densidad_bordes": {"$ref": "#/$defs/u"},
                               "alta_frecuencia": {"$ref": "#/$defs/u"}, "pendiente_espectral": {"type": ["number", "null"]},
                               "grano": {"type": "number", "minimum": 0}}},
    "bordes": {"type": "object", "required": ["duros", "suaves", "nitidez", "hay"],
               "properties": {"duros": {"$ref": "#/$defs/u"}, "suaves": {"$ref": "#/$defs/u"},
                              "nitidez": {"$ref": "#/$defs/u"}, "hay": {"type": "boolean"}}},
    "profundidad": {"type": "object", "required": ["rango_enfoque", "gradiente_contraste", "gradiente_croma", "pista"],
                    "properties": {"rango_enfoque": {"$ref": "#/$defs/u"}, "gradiente_contraste": {"$ref": "#/$defs/s"},
                                   "gradiente_croma": {"$ref": "#/$defs/s"},
                                   "pista": {"enum": ["plana", "atmosferica", "foco_selectivo"]}}},
    "texto": {"type": "object", "required": ["hay", "area", "bloques", "alineacion", "cajas"],
              "properties": {"hay": {"type": "boolean"}, "area": {"type": "number", "minimum": 0},
                             "bloques": {"type": "integer", "minimum": 0},
                             "alineacion": {"enum": ["izquierda", "centro", "derecha", "justificado", "libre", null]},
                             "cajas": {"type": "array"}, "confianza": {"type": "string"}}},
    "tipografia": {"type": "object", "required": ["hay", "lineas", "niveles", "peso", "escala", "clase"],
                   "description": "Lo medible de la letra sin reconocerla. `clase` (serif, palo seco, mono…) la rellena el modelo.",
                   "properties": {"hay": {"type": "boolean"}, "lineas": {"type": "integer", "minimum": 0},
                                  "area": {"type": "number", "minimum": 0},
                                  "alineacion": {"enum": ["izquierda", "centro", "derecha", "justificado", "libre", null]},
                                  "niveles": {"type": "array", "items": {"type": "object", "required": ["alto", "lineas", "escala"]}},
                                  "escala": {"type": ["number", "null"], "description": "alto del segundo nivel / alto del titular"},
                                  "peso": {"type": ["number", "null"], "description": "grosor del trazo / alto de la letra"},
                                  "peso_clase": {"enum": ["fina", "regular", "negrita", "extra", null]},
                                  "tracking": {"type": ["number", "null"], "description": "hueco mediano entre letras / alto de la letra"},
                                  "caja": {"enum": ["alta", "mixta", "baja_o_mixta", null]},
                                  "clase": {"$ref": "#/$defs/txt"}, "confianza": {"type": "string"}}},
    "patron": {"type": "object", "required": ["hay", "tipo", "periodo", "angulo", "fuerza"],
               "description": "Patrón fino repetido (semitono, rayado, cuadrícula), por autocorrelación a resolución nativa.",
               "properties": {"hay": {"type": "boolean"}, "tipo": {"enum": ["puntos", "rayas", null]},
                              "periodo": {"type": ["number", "null"], "description": "fracción del lado mayor"},
                              "periodo_px": {"type": ["number", "null"]}, "angulo": {"type": ["number", "null"]},
                              "fuerza": {"type": "number"}, "escala": {"enum": ["nativa", "global"]}}},
    "tratamiento": {"type": "object", "required": ["duotono", "desregistro", "vineta"],
                    "properties": {
                     "duotono": {"type": "object", "required": ["hay", "ajuste"],
                                 "properties": {"hay": {"type": "boolean"}, "ajuste": {"$ref": "#/$defs/u"},
                                                "sombra": {"type": "string"}, "luz": {"type": "string"}}},
                     "desregistro": {"type": "object", "required": ["hay", "px"],
                                     "properties": {"hay": {"type": "boolean"}, "px": {"type": "number", "minimum": 0},
                                                    "angulo": {"type": ["number", "null"]}, "respuesta": {"type": "number"}}},
                     "vineta": {"type": "object", "required": ["hay", "fuerza"],
                                "properties": {"hay": {"type": "boolean"}, "fuerza": {"type": "number"}}}}}
   }
  },
  "reproducir": {"type": "array", "items": {
   "type": "object", "required": ["metrica", "grupo", "objetivo", "tolerancia", "como"],
   "properties": {"metrica": {"type": "string"}, "grupo": {"enum": ["estilo", "composicion"]},
                  "objetivo": {"type": "number"}, "tolerancia": {"type": "number", "exclusiveMinimum": 0},
                  "como": {"type": "string"}}}},
  "pistas_mejora": {"$ref": "#/$defs/lista"},
  "filosofia": {
   "type": "object",
   "description": "Capa 2: la rellena el modelo mirando la imagen, la hoja y las métricas. null = sin rellenar.",
   "required": ["movimiento", "emocion", "regla_generadora", "donde_no", "que_la_distingue", "no_copiar", "como_mejorar"],
   "properties": {
    "movimiento": {"$ref": "#/$defs/txt"}, "emocion": {"$ref": "#/$defs/txt"},
    "regla_generadora": {"$ref": "#/$defs/txt"}, "significado": {"$ref": "#/$defs/txt"},
    "donde_actua": {"$ref": "#/$defs/txt"}, "donde_no": {"$ref": "#/$defs/txt"},
    "variacion": {"$ref": "#/$defs/txt"}, "anatomia": {"$ref": "#/$defs/txt"},
    "reglas_que_rompe": {"$ref": "#/$defs/lista"}, "que_la_distingue": {"$ref": "#/$defs/txt"},
    "tomar": {"$ref": "#/$defs/lista"}, "no_copiar": {"$ref": "#/$defs/lista"}, "como_mejorar": {"$ref": "#/$defs/lista"}},
   "additionalProperties": false
  },
  "video": {
   "type": "object",
   "description": "Capa 3. `sugerido` y `traduccion` salen de las medidas; el resto lo rellena el modelo.",
   "required": ["sugerido", "traduccion"],
   "properties": {
    "sugerido": {"type": "object", "required": ["modo", "modos", "camara"],
                 "properties": {"modo": {"enum": ["kenburns", "parallax", "capas", "ciclo", "revelado"]},
                                "modos": {"type": "array", "items": {"type": "object", "required": ["modo", "por"]}},
                                "camara": {"type": "array", "items": {"type": "object", "required": ["x", "y", "zoom"]}},
                                "paralaje_eje": {"type": "array"}, "bucle": {"type": "boolean"}, "pieza_grafica": {"type": "boolean"},
                                "grano": {"type": "number"}, "duracion_s": {"type": "number"}}},
    "traduccion": {"type": "array", "items": {"type": "object", "required": ["rasgo", "movimiento"],
                   "properties": {"rasgo": {"type": "string"}, "movimiento": {"type": "string"}, "por": {"type": "string"}}}},
    "que_se_anima": {"$ref": "#/$defs/txt"}, "camara": {"$ref": "#/$defs/txt"}, "ritmo": {"$ref": "#/$defs/txt"},
    "transiciones": {"$ref": "#/$defs/txt"},
    "plan": {"type": ["array", "null"], "items": {"type": "object", "required": ["t", "que"]}}}
  }
 }
}
