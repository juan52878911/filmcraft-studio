{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/juan52878911/filmcraft-studio/plugins/filmcraft-studio/schemas/plan.schema.json",
 "title": "plan.json: EDL de intención de un montaje (plan_compile.py)",
 "description": "Básico: forma de bloques, planos y textos. Lo que depende del DS (roles, sfx, transiciones) lo comprueba plan_compile.py. Referencia: skills/montaje-headless/references/plan.md.",
 "type": "object",
 "required": ["ds", "bloques"],
 "properties": {
  "$schema": {"type": "string"},
  "version": {"type": "integer"}, "titulo": {"type": "string"}, "ds": {"type": "string"},
  "estrategia": {"type": "string"},
  "correcciones": {"type": "object", "additionalProperties": {"type": "string"}},
  "resaltar": {"type": "array", "items": {"type": "string"},
               "description": "pegatina@1: palabras que se resaltan en los subtítulos además de cifras y nombres propios"},
  "bloques": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bloque"}}
 },
 "$defs": {
  "bloque": {"type": "object", "required": ["id", "tipo"],
   "properties": {
    "id": {"type": "string", "minLength": 1},
    "tipo": {"enum": ["gancho", "contenido", "humano", "invitados", "tarjeta", "titulo", "cierre", "fotos", "escena"]},
    "dur": {"type": "number", "exclusiveMinimum": 0}, "transicion": {"type": "string"}, "resumen": {"type": "string"},
    "subtitulos": {"type": "boolean"},
    "planos": {"type": "array", "items": {"$ref": "#/$defs/plano"}},
    "textos": {"type": "array", "items": {"type": "object", "required": ["rol", "texto"],
               "properties": {"rol": {"type": "string"}, "texto": {"type": "string"}, "palabra": {"type": "string"},
                              "t": {"type": "number", "minimum": 0}, "variante": {"type": "integer"}}}},
    "sfx": {"type": "array", "items": {"type": "object", "required": ["tipo"],
            "properties": {"tipo": {"type": "string"}, "t": {"type": "number"}, "db": {"type": "number"}}}},
    "capas": {"type": "array", "items": {"type": "object",
              "properties": {"img": {"type": "string"}, "t": {"type": "number"}, "palabra": {"type": "string"},
                             "dur": {"type": "number", "exclusiveMinimum": 0},
                             "pos": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
                             "anim": {"enum": ["golpe", "desliza", "caida", "pop", "ninguna"]}, "inclina": {"type": "number"},
                             "tarjeta": {"type": "object", "required": ["tipo"],
                                         "description": "pegatina@1: tarjeta compuesta dibujada a la escala del lienzo",
                                         "properties": {"tipo": {"enum": ["ponente", "fecha", "qr", "logo", "flecha"]}}}}}},
    "fotos": {"type": "array", "items": {"type": "string"}}, "f": {"type": "number"}}},
  "plano": {"type": "object", "required": ["src", "in", "out"],
   "properties": {"src": {"type": "string"}, "in": {"type": "number", "minimum": 0}, "out": {"type": "number", "minimum": 0},
                  "speed": {"type": "number", "exclusiveMinimum": 0}, "zoom": {"type": "object"}, "entrada": {"type": "string"}}}
 }
}
